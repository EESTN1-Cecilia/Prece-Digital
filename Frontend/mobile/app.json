{
  "expo": {
    "name": "Prece Digital Alumno",
    "slug": "prece-digital-alumno",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usamos Face ID para que ingreses a tu cuenta sin escribir la contraseña."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/logo.png"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "scheme": "precedigital-alumno",
    "icon": "./assets/logo.png"
  }
}
