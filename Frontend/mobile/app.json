{
  "expo": {
    "name": "Prece Digital",
    "slug": "prece-digital-alumno",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usamos Face ID para que ingreses a tu cuenta sin escribir la contraseña.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.eestn1.precedigital",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.eestn1.precedigital",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro"
    },
    "scheme": "precedigital-alumno",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "imageWidth": 200
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "dad95902-1dfc-476d-9212-cdc587e6016d"
      }
    }
  }
}
