# Entorno: development | production. En production la API DEBE ser https://
EXPO_PUBLIC_APP_ENV=development

# Normalmente NO hace falta definir nada mas: en desarrollo la app toma la IP de
# tu PC desde Expo y usa el puerto 3000 (el mismo Backend que la web).
# Solo si la deteccion falla, fija la URL a mano (IP de tu PC con `ipconfig`):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.0.15:3000
