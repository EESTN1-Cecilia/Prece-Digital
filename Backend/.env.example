APP_ENV=development
API_PORT=3000
DATABASE_CLIENT=mysql
DATABASE_URL=mysql://user:password@localhost:3306/prece_digital
PRODUCTION_DATABASE_CLIENT=postgres
PRODUCTION_DATABASE_URL=postgres://user:password@localhost:5432/prece_digital
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Limite de intentos de login (proteccion contra fuerza bruta).
LOGIN_MAX_EMAIL_ATTEMPTS=5
LOGIN_MAX_IP_ATTEMPTS=20
LOGIN_WINDOW_MS=900000
LOGIN_LOCK_MS=900000

# Solo desarrollo: id de usuario que la API asume autenticado para endpoints de autorizacion DB.
# Dejar vacio para exigir autenticacion real.
AUTH_DEV_USER_ID=
