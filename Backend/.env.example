APP_ENV=development
API_PORT=3000
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Limite de intentos de login (proteccion contra fuerza bruta).
LOGIN_MAX_EMAIL_ATTEMPTS=5
LOGIN_MAX_IP_ATTEMPTS=20
LOGIN_WINDOW_MS=900000
LOGIN_LOCK_MS=900000


# Base de datos. Con DB_CLIENT=memoria (o sin definir) nada se guarda al reiniciar.
# DB_CLIENT=mysql     -> XAMPP/MariaDB. La base se crea sola.
#                        Ejemplo XAMPP: DB_SERVER=localhost DB_PORT=3306 DB_USER=root DB_PASSWORD=
# DB_CLIENT=sqlserver -> SQL Server (Express sirve). La base DB_NAME tiene que existir; las tablas se crean solas.
#                        Ejemplo: DB_SERVER=localhost DB_PORT=1433 DB_USER=prece_api DB_PASSWORD=...
#                        Con una instancia con nombre: DB_INSTANCE=SQLEXPRESS (requiere SQL Server Browser).
# Con mysql o sqlserver cada coleccion se guarda en su tabla ps_<coleccion> (database/persistencia.mjs).
DB_CLIENT=memoria
# Portal del alumno sobre las tablas academicas reales de SQL Server (requiere
# database/sqlserver/001_portal_alumno.sql). Por defecto lee los mismos datos que el resto.
DB_PORTAL=memoria
DB_SERVER=localhost
DB_PORT=1433
DB_INSTANCE=
DB_NAME=prece_digital
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MAX=10

# Seguridad HTTP. En produccion CORS_ORIGINS es obligatorio (lista separada por comas).
CORS_ORIGINS=
# Activar solo detras de un proxy propio que reescriba X-Forwarded-For.
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH=300
RATE_LIMIT_READ=3000
RATE_LIMIT_WRITE=1000

# Administrador inicial, solo produccion. Sin valores reales en este archivo.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
