APP_ENV=development
API_PORT=3000
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Limite de intentos de login (proteccion contra fuerza bruta).
LOGIN_MAX_EMAIL_ATTEMPTS=5
LOGIN_MAX_IP_ATTEMPTS=20
LOGIN_WINDOW_MS=900000
LOGIN_LOCK_MS=900000


# Base de datos SQL Server (ver database/sqlserver/README.md).
# Con DB_CLIENT=memoria (o sin definir) la API usa el store en memoria.
DB_CLIENT=memoria
DB_SERVER=localhost
DB_PORT=1433
DB_INSTANCE=
DB_NAME=prece_digital
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MAX=10
