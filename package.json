{
  "name": "prece-digital",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo de Prece Digital: Backend, Frontend web, Frontend mobile y Shared.",
  "type": "module",
  "scripts": {
    "dev": "node Shared/scripts/dev.mjs",
    "dev:api": "npm run dev -w @prece-digital/api",
    "dev:web": "npm run dev -w @prece-digital/web",
    "dev:mobile": "npm run dev -w @prece-digital/mobile",
    "start:api": "npm run start -w @prece-digital/api",
    "start:web": "npm run dev -w @prece-digital/web",
    "check": "node Shared/scripts/check.mjs",
    "test": "npm test -w @prece-digital/api && npm test -w @prece-digital/web",
    "build": "npm run build -w @prece-digital/web",
    "docs:endpoints": "npm run docs:endpoints -w @prece-digital/api"
  },
  "workspaces": [
    "Backend",
    "Frontend/web",
    "Frontend/mobile",
    "Shared"
  ],
  "license": "MIT"
}
